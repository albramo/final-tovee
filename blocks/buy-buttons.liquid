
{% render 'theme-drawer-styles' %}
{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = closest.product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy

  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t

  if variant
    if variant.quantity_rule.min > variant.inventory_quantity and inventory_managed and inventory_policy == 'deny'
      assign quantity_rule_soldout = true
    endif

    if variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    elsif inventory_managed and inventory_quantity <= 0 and inventory_policy == 'deny' or quantity_rule_soldout
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.sold_out' | t
    else
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.unavailable' | t
    endif
  endif
%}

<span
  class="buy-buttons-block buy-buttons-block--{{ block.id }}"
  {% if block_settings.text_color != blank %}
    style="--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb  }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
    {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
      data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section, block: block -%}
          <span class="buy-buttons-block__bar">
        {%- endif -%}
        <div
          class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
          style="{% render 'spacing-style', settings: block_settings %}"
          ref="productFormButtons"
        >
          {%- unless block_settings.gift_card_form and product.gift_card? -%}
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
          {%- endunless -%}

          {%- liquid
            assign has_quantity_rules = false
            if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
              assign has_quantity_rules = true
            endif
          -%}

          {%- if has_quantity_rules -%}
            {%- assign cart_quantity = cart | item_count_for_variant: variant.id -%}
            <div
              class="quantity-label"
              ref="quantityLabel"
            >
              {{ 'products.product.quantity' | t }}
              <span
                class="quantity-label__cart-count{% if cart_quantity == 0 %} hidden{% endif %}"
                ref="quantityLabelCartCount"
                >({{ cart_quantity }}
                {{ 'products.product.in_cart' | t }})</span
              >
            </div>
          {%- endif -%}

          {% content_for 'block', type: 'quantity', id: 'quantity' %}

          <button
            type="button"
            class="product-wishlist-btn button-unstyled"
            data-wishlist-toggle
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-image="{{ product.featured_image | image_url: width: 400 }}"
            data-product-price="{{ product.selected_or_first_available_variant.price | money | strip_html | escape }}"
            aria-label="Wishlist"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>

          <script>
            (function() {
              var btn = document.querySelector('.product-form-buttons .product-wishlist-btn[data-wishlist-toggle]');
              if (!btn) return;
              var productId = btn.dataset.productId;
              var stored = JSON.parse(localStorage.getItem('wishlist') || '[]');
              if (stored.some(function(item) { return item.id === productId; })) {
                btn.setAttribute('data-active', '');
              }
              if (!btn.dataset.wishlistBound) {
                btn.dataset.wishlistBound = 'true';
                btn.addEventListener('click', function(e) {
                  e.preventDefault();
                  var list = JSON.parse(localStorage.getItem('wishlist') || '[]');
                  var idx = list.findIndex(function(item) { return item.id === productId; });
                  if (idx === -1) {
                    list.push({
                      id: productId,
                      handle: btn.dataset.productHandle || '',
                      title: btn.dataset.productTitle || '',
                      image: btn.dataset.productImage || '',
                      price: btn.dataset.productPrice || ''
                    });
                    btn.setAttribute('data-active', '');
                  } else {
                    list.splice(idx, 1);
                    btn.removeAttribute('data-active');
                  }
                  localStorage.setItem('wishlist', JSON.stringify(list));
                  if (window.wishlistDrawer && window.wishlistDrawer.updateBadges) window.wishlistDrawer.updateBadges();
                });
              }
            })();
          </script>

          {%- if has_quantity_rules -%}
            <div
              class="quantity-rules"
              ref="quantityRules"
            >
              {%- if variant.quantity_rule.increment > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_increments' | t: increment: variant.quantity_rule.increment }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.min > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_minimum' | t: minimum: variant.quantity_rule.min }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.max != null -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_maximum' | t: maximum: variant.quantity_rule.max }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if product.quantity_price_breaks_configured? and variant.quantity_price_breaks.size > 0 -%}
            {%- liquid
              assign use_currency = settings.currency_code_enabled_product_pages
            -%}
            <volume-pricing
              class="volume-pricing"
              data-section-id="{{ section.id }}"
              ref="volumePricing"
            >
              <span class="volume-pricing__title">{{ 'content.volume_pricing' | t }}</span>
              <div class="volume-pricing__table">
                <div class="volume-pricing__row volume-pricing__row--even">
                  <span>{{ variant.quantity_rule.min }}+</span>
                  <span>
                    {%- if use_currency -%}
                      {{- variant.price | money_with_currency | strip -}}
                    {%- else -%}
                      {{- variant.price | money | strip -}}
                    {%- endif -%}
                    /{{ 'content.each_abbreviation' | t -}}
                  </span>
                </div>
                {%- for price_break in variant.quantity_price_breaks limit: 2 -%}
                  {%- liquid
                    assign row_index = forloop.index
                    if row_index == 1
                      assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                    else
                      assign row_class = 'volume-pricing__row volume-pricing__row--even'
                    endif
                  -%}
                  <div class="{{ row_class }}">
                    <span>{{ price_break.minimum_quantity }}+</span>
                    <span>
                      {%- if use_currency -%}
                        {{- price_break.price | money_with_currency | strip -}}
                      {%- else -%}
                        {{- price_break.price | money | strip -}}
                      {%- endif -%}
                      /{{ 'content.each_abbreviation' | t -}}
                    </span>
                  </div>
                {%- endfor -%}

                {%- if variant.quantity_price_breaks.size > 2 -%}
                  <div class="volume-pricing__collapsible-wrapper">
                    {%- for price_break in variant.quantity_price_breaks offset: 2 -%}
                      {%- liquid
                        assign collapsed_index = forloop.index
                        assign total_index = collapsed_index | plus: 2
                        assign modulo_result = total_index | modulo: 2
                        if modulo_result == 1
                          assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                        else
                          assign row_class = 'volume-pricing__row volume-pricing__row--even'
                        endif
                      -%}
                      <div class="{{ row_class }}">
                        <span>{{ price_break.minimum_quantity }}+</span>
                        <span>
                          {%- if use_currency -%}
                            {{- price_break.price | money_with_currency | strip -}}
                          {%- else -%}
                            {{- price_break.price | money | strip -}}
                          {%- endif -%}
                          /{{ 'content.each_abbreviation' | t -}}
                        </span>
                      </div>
                    {%- endfor -%}
                  </div>

                  <button
                    type="button"
                    class="volume-pricing__toggle button-unstyled"
                    ref="volumePricingToggle"
                    on:click="/toggleExpanded"
                  >
                    <span class="volume-pricing__toggle-text">
                      <span class="volume-pricing__show-more">+ {{ 'actions.show_more' | t }}</span>
                      <span class="volume-pricing__show-less">- {{ 'actions.show_less' | t }}</span>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            </volume-pricing>
          {%- endif -%}
          {% content_for 'block',
            type: 'add-to-cart',
            id: 'add-to-cart',
            can_add_to_cart: can_add_to_cart,
            add_to_cart_text: add_to_cart_text
          %}

          {% content_for 'block',
            type: 'accelerated-checkout',
            id: 'accelerated-checkout',
            can_add_to_cart: can_add_to_cart,
            form_obj: form
          %}
        </div>
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          </span>
        {%- endif -%}
      {%- endform -%}
    </product-form-component>
  {%- else -%}
    <div class="product-form-buttons">
      <button
        type="submit"
        name="add"
        class="button"
        disabled
      >
        {{ 'blocks.sold_out' | t }}
      </button>
    </div>
  {%- endif -%}
</span>

{% comment %} Delivery & Return + Ask a Question {% endcomment %}
<div class="delivery-return-text-wrapper">
  <button type="button" class="delivery-return-text" data-delivery-modal-trigger>
    Delivery & Return
  </button>
  <span class="delivery-return-divider">|</span>
  <button type="button" class="delivery-return-text" data-contact-modal-trigger>
    Ask a Question
  </button>
</div>

<dialog class="delivery-return-modal" data-delivery-modal>
  <div class="delivery-return-modal__dialog">
    <div class="delivery-return-modal__header">
      <div class="delivery-return-modal__title">Delivery & Return Policy</div>
      <button type="button" class="delivery-return-modal__close" data-delivery-modal-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="delivery-return-modal__body" data-delivery-modal-body>
      {% if shop.refund_policy.body != blank %}
        <div class="rte">{{ shop.refund_policy.body }}</div>
      {% elsif shop.shipping_policy.body != blank %}
        <div class="rte">{{ shop.shipping_policy.body }}</div>
      {% else %}
        <div class="delivery-return-modal__loading">
          <div class="delivery-return-spinner"></div>
          <span>Loading policy...</span>
        </div>
      {% endif %}
    </div>
  </div>
</dialog>

{% comment %} Complete Your Routine / أكمل روتينك {% endcomment %}
{% liquid
  assign show_routine = block_settings.show_routine
  if show_routine == null
    assign show_routine = true
  endif
  assign routine_collection = product.collections.first | default: collections.all
%}
{% if show_routine and routine_collection != blank and routine_collection.products_count > 1 %}
  <div class="routine-section">
    <div class="routine-section__header">
      <h3 class="routine-section__title">
        {% if block_settings.routine_title != blank %}
          {{ block_settings.routine_title }}
        {% elsif request.locale.iso_code contains 'ar' %}
          أكمل روتينك
        {% else %}
          Complete Your Routine
        {% endif %}
      </h3>
    </div>
    <div class="routine-section__products">
      {% assign count = 0 %}
      {% for routine_product in routine_collection.products %}
        {% if routine_product.id != product.id and count < 3 %}
          {% assign count = count | plus: 1 %}
          {% assign variant_id = routine_product.selected_or_first_available_variant.id %}
          <div class="routine-card">
            <a href="{{ routine_product.url }}" class="routine-card__image-link">
              {% if routine_product.featured_image %}
                <img
                  src="{{ routine_product.featured_image | image_url: width: 140 }}"
                  alt="{{ routine_product.title | escape }}"
                  loading="lazy"
                  width="70"
                  height="70"
                  class="routine-card__image"
                >
              {% else %}
                <div class="routine-card__image-placeholder"></div>
              {% endif %}
            </a>
            <div class="routine-card__info">
              <a href="{{ routine_product.url }}" class="routine-card__title">
                {{ routine_product.title }}
              </a>
              <div class="routine-card__price">
                {% if routine_product.compare_at_price > routine_product.price %}
                  <s class="routine-card__compare-price">{{ routine_product.compare_at_price | money }}</s>
                  <span class="routine-card__sale-price">{{ routine_product.price | money }}</span>
                {% else %}
                  {{ routine_product.price | money }}
                {% endif %}
              </div>
            </div>
            <button
              type="button"
              class="routine-card__btn"
              data-add
              data-variant-id="{{ variant_id }}"
              data-quantity="1"
              data-add-text="{% if request.locale.iso_code contains 'ar' %}إضافة{% else %}Add{% endif %}"
              data-added-text="{% if request.locale.iso_code contains 'ar' %}تمت الإضافة{% else %}Added{% endif %}"
            >
              <span class="routine-card__spinner" aria-hidden="true"></span>
              <span data-text-label>{% if request.locale.iso_code contains 'ar' %}إضافة{% else %}Add{% endif %}</span>
            </button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

<dialog class="delivery-return-modal" data-contact-modal>
  <div class="delivery-return-modal__dialog">
    <div class="delivery-return-modal__header">
      <div class="delivery-return-modal__title">Ask a Question</div>
      <button type="button" class="delivery-return-modal__close" data-contact-modal-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="delivery-return-modal__body" data-contact-modal-body>
      <div class="delivery-return-modal__loading">
        <div class="delivery-return-spinner"></div>
        <span>Loading...</span>
      </div>
    </div>
  </div>
</dialog>

<style>
  .delivery-return-text-wrapper {
    margin-top: 14px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .delivery-return-text {
    background: none;
    border: none;
    padding: 0;
    color: #000000;
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  a.delivery-return-text {
    text-decoration: underline;
  }

  .delivery-return-text:hover {
    color: #800020;
  }

  .delivery-return-divider {
    color: #999;
    font-size: 0.9rem;
  }

  .delivery-return-modal {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 640px;
    width: 92%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
  }

  .delivery-return-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .delivery-return-modal__dialog {
    background: #ffffff;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    max-height: 85dvh;
    overflow: hidden;
  }

  .delivery-return-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #e5e7eb;
    background: #ffffff;
  }

  .delivery-return-modal__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #000000;
    margin: 0;
  }

  .delivery-return-modal__close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #800020 !important;
    color: #ffffff !important;
    border: none !important;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .delivery-return-modal__close:hover {
    background: #600018 !important;
  }

  .delivery-return-modal__body {
    padding: 20px 24px;
    overflow-y: auto;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #111827;
  }

  .delivery-return-modal__loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 20px;
    color: #6b7280;
  }

  .delivery-return-spinner {
    width: 24px;
    height: 24px;
    border: 3px solid #f3f4f6;
    border-top-color: #800020;
    border-radius: 50%;
    animation: delivery-spin 0.8s linear infinite;
  }

  @keyframes delivery-spin {
    to { transform: rotate(360deg); }
  }

  /* Routine Section Styles */
  .routine-section {
    margin-top: 20px;
    padding: 16px;
    background: #fafafa;
    border: 1px solid #eaeaea;
    border-radius: 12px;
  }

  .routine-section__header {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #eeeeee;
  }

  .routine-section__title {
    font-size: 1rem;
    font-weight: 700;
    color: #111111;
    margin: 0;
  }

  .routine-section__products {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .routine-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid #f0f0f0;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .routine-card:hover {
    border-color: #dddddd;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .routine-card__image-link {
    flex-shrink: 0;
    display: block;
    width: 54px;
    height: 54px;
    border-radius: 6px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .routine-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .routine-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: #e0e0e0;
  }

  .routine-card__info {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .routine-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #222222;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .routine-card__title:hover {
    color: #800020;
  }

  .routine-card__price {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333333;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .routine-card__compare-price {
    color: #999999;
    font-size: 0.8rem;
    text-decoration: line-through;
  }

  .routine-card__sale-price {
    color: #800020;
    font-weight: 700;
  }

  .routine-card__btn {
    flex-shrink: 0;
    min-width: 80px;
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    background: #800020;
    border: none;
    border-radius: 24px;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: 0 3px 8px rgba(128, 0, 32, 0.25);
    transition: all 0.2s ease;
  }

  .routine-card__btn:hover:not(:disabled) {
    background: #600018;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(128, 0, 32, 0.3);
  }

  .routine-card__btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .routine-card__btn.is-added {
    background: #22c55e !important;
    color: #ffffff !important;
  }

  .routine-card__spinner {
    display: none;
    width: 12px;
    height: 12px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: routine-spin 0.7s linear infinite;
  }

  .routine-card__btn.is-loading .routine-card__spinner {
    display: inline-block;
  }

  .routine-card__btn.is-loading [data-text-label] {
    display: none;
  }

  @keyframes routine-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  (function() {
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.routine-card__btn[data-add]');
      if (!btn || btn.disabled) return;
      e.preventDefault();
      var variantId = btn.dataset.variantId;
      if (!variantId) return;

      btn.disabled = true;
      btn.classList.add('is-loading');

      var formData = new FormData();
      formData.set('id', variantId);
      formData.set('quantity', '1');

      var sectionIds = [];
      document.querySelectorAll('cart-items-component').forEach(function(el) {
        if (el.dataset.sectionId) sectionIds.push(el.dataset.sectionId);
      });
      if (sectionIds.length) formData.append('sections', sectionIds.join(','));

      var deferredPromise = null;
      var createPromiseFn = window.ShopifyEvents?.CartLinesUpdateEvent?.createPromise || window.CartLinesUpdateEvent?.createPromise;
      var EventClass = window.ShopifyEvents?.CartLinesUpdateEvent || window.CartLinesUpdateEvent;

      if (createPromiseFn && EventClass) {
        deferredPromise = createPromiseFn();
        document.dispatchEvent(new EventClass({
          action: 'add',
          context: 'cart',
          lines: [{ merchandiseId: variantId, quantity: 1 }],
          promise: deferredPromise.promise
        }));
      }

      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' }
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var cartUrl = window.Theme?.routes?.cart_url || '/cart';
        return fetch(cartUrl + '.json', { headers: { Accept: 'application/json' } })
          .then(function(res) { return res.json(); })
          .then(function(cartData) {
            if (deferredPromise && EventClass && typeof EventClass.createCartFromAjaxResponse === 'function') {
              deferredPromise.resolve({
                cart: EventClass.createCartFromAjaxResponse(cartData),
                detail: {
                  sections: data.sections || {},
                  items: cartData.items || [],
                  itemCount: cartData.item_count || 0,
                  source: 'routine-add',
                  didError: false
                }
              });
            }

            btn.classList.remove('is-loading');
            btn.classList.add('is-added');
            var label = btn.querySelector('[data-text-label]');
            var origLabel = label ? label.textContent : '';
            if (label && btn.dataset.addedText) label.textContent = btn.dataset.addedText;

            setTimeout(function() {
              btn.classList.remove('is-added');
              if (label && origLabel) label.textContent = origLabel;
              btn.disabled = false;
            }, 1800);

            var drawer = document.querySelector('theme-drawer#cart-drawer');
            if (drawer && typeof drawer.open === 'function') {
              drawer.open();
            }
          });
      })
      .catch(function(err) {
        console.error('Error adding routine product to cart:', err);
        if (deferredPromise) deferredPromise.reject(err);
        btn.classList.remove('is-loading');
        btn.disabled = false;
      });
    });
    function openModal(trigger, modal, bodyEl, fetchUrl) {
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }

      if (bodyEl && fetchUrl && (!bodyEl.dataset.fetched || bodyEl.querySelector('.delivery-return-modal__loading'))) {
        fetch(fetchUrl)
          .then(function(res) { return res.text(); })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var content = doc.querySelector('.shopify-policy__container') || doc.querySelector('.shopify-policy__body') || doc.querySelector('main');
            if (content && bodyEl) {
              bodyEl.innerHTML = content.innerHTML;
              bodyEl.dataset.fetched = 'true';
            }
          })
          .catch(function(err) {
            console.error('Failed to load content:', err);
          });
      }
    }

    function closeModalFn(modal) {
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
    }

    function initModals() {
      document.querySelectorAll('[data-delivery-modal-trigger]').forEach(function(trigger) {
        if (trigger.dataset.bound) return;
        trigger.dataset.bound = 'true';
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var wrapper = trigger.closest('.delivery-return-text-wrapper');
          var modal = wrapper ? wrapper.parentElement.querySelector('[data-delivery-modal]') : document.querySelector('[data-delivery-modal]');
          var bodyEl = modal ? modal.querySelector('[data-delivery-modal-body]') : null;
          if (modal) openModal(trigger, modal, bodyEl, '/policies/refund-policy');
        });
      });

      document.querySelectorAll('[data-contact-modal-trigger]').forEach(function(trigger) {
        if (trigger.dataset.bound) return;
        trigger.dataset.bound = 'true';
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var wrapper = trigger.closest('.delivery-return-text-wrapper');
          var modal = wrapper ? wrapper.parentElement.querySelector('[data-contact-modal]') : document.querySelector('[data-contact-modal]');
          var bodyEl = modal ? modal.querySelector('[data-contact-modal-body]') : null;
          if (modal) openModal(trigger, modal, bodyEl, '/pages/contact');
        });
      });

      document.querySelectorAll('.delivery-return-modal').forEach(function(modal) {
        if (modal.dataset.bound) return;
        modal.dataset.bound = 'true';

        var closeBtn = modal.querySelector('[data-delivery-modal-close], [data-contact-modal-close]');
        function close() { closeModalFn(modal); }

        if (closeBtn) closeBtn.addEventListener('click', close);
        modal.addEventListener('click', function(e) {
          if (e.target === modal) close();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initModals);
    } else {
      initModals();
    }
  })();
</script>

{% if block_settings.show_pickup_availability %}
  <script
    src="{{ 'local-pickup.js' | asset_url }}"
    type="module"
  ></script>

  {%- assign pick_up_availabilities = closest.product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <local-pickup
    class="spacing-style product__pickup-availabilities"
    {% if pick_up_availabilities.size == 0 %}
      hidden
    {% endif %}
    data-section-id="{{ section.id }}"
    data-product-url="{{ closest.product.url }}"
    data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.text_color != blank %}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }}
      {% endif %}
    "
    ref="localPickupButton"
  >
    {% if can_add_to_cart %}
      <div class="pickup-availability__row">
        <div class="pickup-availability__column">
          <span class="svg-wrapper">
            {% if pick_up_availabilities.first.available %}
              {{- 'icon-available.svg' | inline_asset_content -}}
            {% else %}
              {{- 'icon-unavailable.svg' | inline_asset_content -}}
            {% endif %}
          </span>
        </div>
        <div class="pickup-availability__column">
          {% if pick_up_availabilities.first.available %}
            <p class="pickup-location__text-sm">
              {{ 'content.pickup_available_at_html' | t: location: pick_up_availabilities.first.location.name }}
            </p>
            <p class="pickup-location__text-xs">
              {{ 'content.pickup_ready_in' | t: pickup_time: pick_up_availabilities.first.pick_up_time }}
            </p>
          {% else %}
            <p class="pickup-location__text-sm">
              {{ 'content.pickup_not_available' | t }}
            </p>
          {% endif %}
          <button
            on:click="#pickup-drawer-{{ block.id }}/toggle"
            class="button-unstyled pickup-location__button"
          >
            {{ 'actions.view_store_information' | t }}
          </button>
        </div>
      </div>
    {% endif %}
  </local-pickup>

  {% if can_add_to_cart %}
    <theme-drawer
      id="pickup-drawer-{{ block.id }}"
      class="pickup-drawer"
      data-skip-node-update
      no-persist
    >
      <dialog
        ref="panel"
        class="theme-drawer__dialog color-custom-drawer"
        aria-labelledby="pickup-dialog-heading-{{ block.id }}"
        data-testid="pickup-location-dialog"
      >
        <h2
          id="pickup-dialog-heading-{{ block.id }}"
          class="visually-hidden"
        >
          {{ 'actions.view_store_information' | t }}
        </h2>
        <div class="theme-drawer__header pickup-availability__header-container">
          <div class="pickup-availability__column">
            <h4 class="pickup-location__h4">{{ closest.product.title }}</h4>
            {% unless closest.product.has_only_default_variant %}
              <p class="pickup-location__text-sm">
                {{ closest.product.selected_or_first_available_variant.title }}
              </p>
            {% endunless %}
          </div>
          <button
            on:click="#pickup-drawer-{{ block.id }}/close"
            class="theme-drawer__close-button"
            type="button"
            aria-label="{{ 'actions.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
        {% for pick_up_availability in pick_up_availabilities %}
          <div class="pickup-location__wrapper">
            <p class="pickup-location__text-bold">{{ pick_up_availability.location.name }}</p>
            <div class="pickup-location__address-wrapper">
              <span class="pickup-location__availability-wrapper">
                {% if pick_up_availability.available %}
                  {{- 'icon-available.svg' | inline_asset_content -}}
                  {% assign pickup_time = pick_up_availability.pick_up_time | downcase %}
                  {{ 'content.pickup_available_in' | t: pickup_time: pickup_time }}
                {% else %}
                  {{- 'icon-unavailable.svg' | inline_asset_content -}}
                  {{ 'content.pickup_not_available' | t }}
                {% endif %}
              </span>
              <address class="pickup-location__address">
                {{ pick_up_availability.location.address | format_address }}
                {{ pick_up_availability.location.address.phone }}
              </address>
            </div>
          </div>
        {% endfor %}
      </dialog>
    </theme-drawer>
  {% endif %}
{% endif %}

