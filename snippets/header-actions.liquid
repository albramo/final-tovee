{% doc %}
  Header Actions Component

  Renders the header actions.

  @param {object} [section] - The section object providing settings such as actions_font.
  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [display_style] - Controls display mode for header actions: 'icon' or 'text'.
  @param {string} [customer_account_menu] - The menu handle passed to the shopify-account component.

  @example
  {% render 'header-actions', section: section %}
{% enddoc %}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

{% capture cart_icon %}
  <cart-icon
    class="header-actions__cart-icon{% if display_style == 'text' %} header-actions__cart-icon--text{% endif %}{% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}"
    data-testid="cart-icon"
  >
    <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
      {{ 'content.cart_title' | t }}
    </span>

    <span
      class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}"
      aria-hidden="true"
    >
      {{ 'icon-cart.svg' | inline_asset_content }}
    </span>

    {% render 'cart-bubble', limit: 100 %}
  </cart-icon>
{% endcapture %}

{% capture account_icon %}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="17"
    viewBox="0 0 15 17"
    fill="none"
    slot="signed-out-avatar"
    class="account-button__icon"
  >
    <path
      stroke="currentColor"
      stroke-linejoin="round"
      stroke-width="var(--icon-stroke-width)"
      d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"
    />
  </svg>
{% endcapture %}

<header-actions
  {% if display_style == 'text' %}
    class="header-actions--text"
  {% endif %}
  {{- block.shopify_attributes -}}
>
  {% comment %} Reversed Order (Cart at outer edge): 1. Account  2. Language  3. Search  4. Wishlist  5. Cart {% endcomment %}

  {%- if localization.available_languages.size > 1 -%}
    <div class="header-actions__lang-wrapper">
      <dropdown-localization-component>
        <button
          type="button"
          class="button-unstyled header-actions__lang-select-container"
          aria-expanded="false"
          aria-haspopup="true"
          ref="button"
          on:click="/toggleSelector"
        >
          <span class="svg-wrapper header-actions__lang-globe" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </span>
          <span class="header-actions__lang-badge desktop:hidden">
            {% if localization.language.iso_code contains 'ar' %}AR{% else %}EN{% endif %}
          </span>
          <span class="header-actions__lang-name mobile:hidden">
            {{ localization.language.endonym_name | default: localization.language.name | capitalize }}
          </span>
          <span class="svg-wrapper header-actions__lang-caret" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>

        <div
          class="localization-wrapper header-actions__lang-popover color-custom-popover"
          hidden
          ref="panel"
        >
          {% render 'localization-form',
            show_country: false,
            show_language: true,
            localization_style: 'dropdown',
            form_id: 'HeaderActionsLang',
            back: request.path
          %}
        </div>
      </dropdown-localization-component>
    </div>
  {%- endif -%}

  {% if shop.customer_accounts_enabled %}
    {% liquid
      assign account_actions_style = ''
      if display_style == 'text' and section
        assign actions_font = section.settings.actions_font | default: 'body'
        assign font_obj = settings.type_heading_font
        case actions_font
          when 'body'
            assign font_obj = settings.type_body_font
          when 'subheading'
            assign font_obj = settings.type_subheading_font
          when 'accent'
            assign font_obj = settings.type_accent_font
        endcase
        assign font_family = font_obj.family | append: ', ' | append: font_obj.fallback_families
        assign font_family_safe = font_family | replace: '"', "'"
        assign account_actions_style = '--header-actions-font-family: ' | append: font_family_safe | append: '; --header-actions-font-weight: ' | append: font_obj.weight | append: ';'
      endif
    %}
    <div
      class="account-button header-actions__action{% if display_style == 'text' %} account-button--text{% endif %} color-custom-popover mobile:hidden"
    >
      <shopify-account
        menu="{{ customer_account_menu }}"
        {% if account_actions_style != blank %}
          style="{{ account_actions_style }}"
        {% endif %}
      >
        {% if customer %}
          <div class="account-button__fallback"></div>
        {% else %}
          <span
            slot="signed-out-avatar"
            class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}"
          >
            {{ 'content.account_title' | t }}
          </span>

          <span
            slot="signed-out-avatar"
            class="{% if display_style != 'icon' %}desktop:hidden{% endif %}"
            aria-hidden="true"
          >
            {{ account_icon }}
          </span>
        {% endif %}
      </shopify-account>
    </div>
  {% endif %}

  {% assign show_mobile_search = section.settings.show_search %}
  {% if show_mobile_search == nil %}
    {% assign show_mobile_search = true %}
  {% endif %}
  {% if show_mobile_search %}
    <search-button class="header-actions__mobile-search search-action">
      <button
        on:click="#search-modal/showDialog"
        class="button-unstyled header-actions__action"
        aria-label="{{ 'content.search_input_label' | t }}"
        aria-haspopup="dialog"
      >
        <span class="svg-wrapper">
          {{ 'icon-search.svg' | inline_asset_content }}
        </span>
      </button>
    </search-button>
  {% endif %}

  <button
    class="header-actions__action button-unstyled header-actions__wishlist-btn mobile:hidden"
    onclick="window.wishlistDrawer && window.wishlistDrawer.open()"
    aria-label="Wishlist"
  >
    <span class="svg-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </span>
    <span class="wishlist-count-badge header-actions__wishlist-count" data-wishlist-count hidden></span>
  </button>

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <button
      class="header-actions__action button-unstyled{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      on:click="#cart-drawer/toggle"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="cart-drawer"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
      data-testid="cart-drawer-trigger"
    >
      {{ cart_icon }}
    </button>
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
    >
      {{ cart_icon }}
    </a>
  {% endif %}

  <span
    ref="liveRegion"
    class="visually-hidden"
    role="status"
    data-testid="cart-count-live-region"
  ></span>
</header-actions>

<script
  type="module"
  src="{{ 'header-actions.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .header {
    --account-offset-top: calc(
      var(--header-group-height) + (var(--header-height) * var(--transparent-header-offset-boolean))
    );

    &[data-sticky-state='active'] {
      --account-offset-top: calc(var(--header-height) - 1px);
    }
  }

  .account-button {
    /* Remove the background color from the color scheme, we want to inherit the color of the header */
    background: transparent;
  }

  .account-button__icon,
  .account-button__text {
    color: var(--color-account-icon);
    transition: color var(--header-content-transition-timing);
    -webkit-font-smoothing: antialiased;
  }

  shopify-account {
    --shopify-account-font-heading: var(--font-heading--family);
    --shopify-account-font-heading-weight: var(--font-heading--weight);
    --shopify-account-font-body: var(--font-body--family);
    --shopify-account-font-body-weight: var(--font-body--weight);
    --shopify-account-radius-base: var(--style-border-radius-popover);
    --shopify-account-radius-button: var(--style-border-radius-buttons-primary);
    --shopify-account-radius-button-small: var(--style-border-radius-buttons-primary);
    --shopify-account-radius-input: var(--style-border-radius-buttons-primary);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-color-accent: var(--color-primary-button-background);
    --shopify-account-color-accent-text: var(--color-primary-button-text);
    --shopify-account-dialog-position-top: var(--account-offset-top);

    &:not(:defined) {
      min-width: 44px;
      height: 44px;
      display: flex;
      justify-content: center;
      align-items: center;
      /* Match the line height of the other buttons */
      line-height: normal;
    }
  }

  .account-button__fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--shopify-account-color-accent, #0a142f);
  }

  .account-button--text shopify-account {
    color: inherit;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
      gap: 0.15rem;
    }
  }

  .header-actions__wishlist-btn {
    position: relative;
  }

  .header-actions__wishlist-btn .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
  }

  .header-actions__wishlist-count {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
  }

  .header-actions__wishlist-btn:hover svg {
    fill: #e74c3c;
    stroke: #e74c3c;
    transition: fill 0.2s, stroke 0.2s;
  }

  @media screen and (max-width: 749px) {
    .header-actions__wishlist-btn {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .header-actions--text {
      gap: var(--gap-xl);
    }

    .header-actions__text-style {
      font-size: var(--header-actions-font-size);
      font-family: var(--header-actions-font-family);
      font-weight: var(--header-actions-font-weight);
      text-transform: var(--header-actions-text-case);
    }
  }

  #header-component[data-menu-style='drawer'] header-actions {
    justify-self: flex-end;
  }

  .header__column--right header-actions {
    margin-inline-start: calc(var(--gap-md) * -1);
  }

  .header-actions__cart-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
  }

  .header-actions__cart-icon .svg-wrapper {
    width: 100%;
    height: 100%;
    flex-shrink: 0;

    & > svg {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  .header-actions__cart-icon .cart-bubble {
    position: absolute;
    width: 17px;
    height: 17px;
    top: -5px;
    inset-inline-end: -8px;
    inset-inline-start: auto;
    transform: none;
    z-index: 5;
    pointer-events: none;
  }

  /* Never clip the cart bubble poking out of the icon corner */
  header-actions,
  header-actions .header-actions__action,
  .header-actions__cart-icon {
    overflow: visible !important;
  }

  .header-actions__cart-icon .cart-bubble__text {
    font-size: 0.5625rem;
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
  }

  .header-actions__cart-icon .cart-bubble__background {
    border-radius: 50%;
  }

  .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
    mask: none !important;
    -webkit-mask: none !important;
  }

  .cart-bubble.cart-bubble--animating .cart-bubble__background {
    animation: grow var(--animation-speed) var(--animation-easing);
  }

  .cart-bubble--animating .cart-bubble__text {
    --start-y: -1em;
    --start-opacity: 1;
    /* Set initial transform state before animation starts */
    transform: translate(0, var(--start-y, -1em));
    opacity: var(--start-opacity, 1);
    animation: move-and-fade var(--animation-speed) var(--animation-easing);
  }

  cart-icon:has(.cart-bubble__text-count:empty) {
    .cart-bubble {
      width: 10px;
      height: 10px;
      top: -2px;
      inset-inline-end: -4px;
      inset-inline-start: auto;
      transform: none;
    }
  }

  .header-actions__lang-wrapper {
    display: flex;
    align-items: center;
  }

  dropdown-localization-component {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-actions__lang-select-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 20px;
    padding: 5px 12px;
    height: 34px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    .header-actions__lang-select-container {
      padding: 3px 8px;
      height: 30px;
      gap: 4px;
    }
  }

  .header-actions__lang-select-container:hover {
    background-color: rgb(var(--color-foreground-rgb) / 0.1);
    border-color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .header-actions__lang-globe {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .header-actions__lang-globe svg {
    width: 14px;
    height: 14px;
  }

  .header-actions__lang-badge,
  .header-actions__lang-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .header-actions__lang-badge {
    text-transform: uppercase;
  }

  .header-actions__lang-caret {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
    color: var(--color-foreground);
    opacity: 0.6;
    transition: transform 0.2s ease;
  }

  .header-actions__lang-caret svg {
    width: 8px;
    height: 8px;
  }

  .header-actions__lang-select-container[aria-expanded='true'] .header-actions__lang-caret {
    transform: rotate(180deg);
  }

  .header-actions__lang-popover {
    position: absolute;
    top: calc(100% + 6px);
    inset-inline-start: 0;
    min-width: 140px;
    background-color: #ffffff !important;
    color: #222222;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    z-index: 100;
    overflow: hidden;
    padding: 6px 4px;
    text-align: start;
  }

  [dir="rtl"] .header-actions__lang-popover,
  html[dir="rtl"] .header-actions__lang-popover {
    inset-inline-start: auto;
    inset-inline-end: 0;
    text-align: right;
  }

  .header-actions__lang-popover .language-selector {
    padding: 0 !important;
  }

  .header-actions__lang-popover .localization-form__list--language {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-actions__lang-popover .language-option-item {
    display: block;
    padding: 0;
    border-radius: 0 !important;
    background-color: transparent !important;
    background: transparent !important;
    font-size: 0.88rem;
    font-weight: 500;
    color: #333333;
    transition: color 0.2s ease;
  }

  .header-actions__lang-popover .language-option-item__btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    border: none;
    border-radius: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: start;
    justify-content: flex-start;
  }

  [dir="rtl"] .header-actions__lang-popover .language-option-item {
    direction: rtl;
    text-align: right;
  }

  .header-actions__lang-popover .language-option-item:hover,
  .header-actions__lang-popover .language-option-item:focus-within,
  .header-actions__lang-popover .language-option-item__btn:hover,
  .header-actions__lang-popover .language-option-item__btn:focus {
    background-color: transparent !important;
    background: transparent !important;
    color: #800020 !important;
  }

  .header-actions__lang-popover .language-option-item.is-active,
  .header-actions__lang-popover .language-option-item[aria-current='true'] {
    background-color: transparent !important;
    background: transparent !important;
    color: #800020 !important;
    font-weight: 700;
  }

  .header-actions__lang-popover .language-option-item .svg-wrapper.icon-checkmark,
  .header-actions__lang-popover .language-option-item .icon-checkmark {
    width: 14px;
    height: 14px;
    color: #800020 !important;
    fill: #800020 !important;
  }

  .header-actions__text {
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .header-actions__cart-icon--text {
      display: flex;
      align-items: center;
      gap: var(--gap-xs);
    }

    .header__column--right .header-actions--text {
      margin-inline-start: 0;
    }
  }

  /* Mobile: push cart icon away from edge & enlarge cart + search icons */
  @media screen and (max-width: 749px) {
    header-actions {
      /* 3px gap + 8px bubble overhang keeps the badge fully visible off the screen edge */
      padding-inline-end: 11px;
    }

    .header-actions__cart-icon {
      width: 2rem;
      height: 2rem;
    }

    .header-actions__cart-icon .svg-wrapper {
      width: 2rem;
      height: 2rem;

      & > svg {
        width: 2rem;
        height: 2rem;
      }
    }

    .header-actions__mobile-search .svg-wrapper {
      width: 2rem;
      height: 2rem;

      & > svg {
        width: 2rem;
        height: 2rem;
      }
    }
  }
{% endstylesheet %}
