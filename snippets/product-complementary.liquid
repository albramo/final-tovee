{%- comment -%}
  Render complementary products

  Accepts:
  - limit: {Number} Number of items to show.
  - image_ratio: {String} Size of the product image card. Values are "square", "landscape" and "portrait". Default is "square" (optional)
  - image_fill: {Boolean} Zoom image to fill space. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_price: {Boolean} Show the product price. Default: false
  - product_id: {String} The ID of the current product.
  - section_id: {String} The ID of section to which this snippet belongs.

  Usage:
  {% render 'product-complementary', limit: 5 %}
{%- endcomment -%}

{%- liquid
  if recommendations.performed
    if recommendations_products != blank
      assign products_count = recommendations_products.count
    elsif recommendations.products_count > 0
      assign recommendations_products = recommendations.products
      assign products_count = recommendations.products_count
    else
      # Fallback: no complementary products - show products not in cart from all collection (only for cart drawer)
      if section_id == 'cart-drawer'
        assign fallback_enabled = true
        assign fallback_products = collections.all.products
        if fallback_products == blank
          assign fallback_products = collections.frontpage.products
        endif
        if fallback_products == blank
          assign fallback_products = collections['all'].products
        endif
        assign cart_ids = cart.items | map: 'product_id'
        assign products_count = 0
        for prod in fallback_products
          unless cart_ids contains prod.id
            assign products_count = products_count | plus: 1
            if products_count >= limit
              break
            endif
          endunless
        endfor
        if products_count > 0
          assign recommendations_products = fallback_products
        endif
      else
        assign fallback_enabled = true
        assign fallback_products = blank
        if product.collections.size > 0
          for coll in product.collections
            if coll.all_products_count > 1
              assign fallback_products = coll.products
              break
            endif
          endfor
        endif
        if fallback_products == blank
          assign fallback_products = collections.all.products
        endif
        assign products_count = 0
        for prod in fallback_products
          unless prod.id == product_id
            assign products_count = products_count | plus: 1
            if products_count >= limit
              break
            endif
          endunless
        endfor
        if products_count > 0
          assign recommendations_products = fallback_products
        endif
      endif
    endif
  endif
-%}
<product-recommendations class="complementary-products flex flex-col gap-5" data-url="{{ routes.product_recommendations_url }}?section_id={{ section_id }}&product_id={{ product_id }}&limit={{ limit }}&intent=complementary" data-fallback-enabled="{{ fallback_enabled }}" data-limit="{{ limit }}" hidden style="display:none;">
  <div class="flex justify-between gap-4 items-center">
    <p class="recommend__title font-medium text-lg grow">{{ heading | escape }}</p>
    {%- if products_count > 1 -%}
      <div class="indicators indicators--small flex gap-2">
        <button class="button button--secondary" type="button" is="hover-button" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled data-prev-button>
          <span class="btn-fill" data-fill></span>
          <span class="btn-text">
            {%- render 'icon', icon: 'chevron-left', size: 'sm', class: 'transform' -%}
          </span>
        </button>
        <button class="button button--secondary" type="button" is="hover-button" aria-label="{{ 'general.pagination.next' | t | escape }}" data-next-button>
          <span class="btn-fill" data-fill></span>
          <span class="btn-text">
            {%- render 'icon', icon: 'chevron-right', size: 'sm', class: 'transform' -%}
          </span>
        </button>
      </div>
    {%- endif -%}
  </div>
  {%- if recommendations.performed -%}
    <product-complementary class="horizontal-products block{% if products_count > 1 %} flickity{% endif %}">
      {%- liquid
        assign rendered_count = 0
        for recommendation in recommendations_products
          if recommendation.id == product_id
            continue
          endif
          if fallback_enabled
            if cart_ids != blank and cart_ids contains recommendation.id
              continue
            endif
            if rendered_count >= limit
              break
            endif
          endif
          render 'product-card-horizontal', product: recommendation, product_id: recommendation.id, section_id: section_id, image_ratio: image_ratio, image_fill: image_fill, show_vendor: show_vendor, show_price: show_price, show_quick_add: settings.product_quick_add, show_quick_view: settings.product_quick_view
          assign rendered_count = rendered_count | plus: 1
          if fallback_enabled and rendered_count >= limit
            break
          endif
        endfor
      -%}
    </product-complementary>
  {%- else -%}
    <div class="horizontal-products relative"></div>
  {%- endif -%}
</product-recommendations>
