{%- comment -%}
  Live viewer counter component under product price
{%- endcomment -%}

{%- liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
-%}

<div class="product-live-viewers" data-live-viewers>
  <span class="product-live-viewers__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
  </span>
  <span class="product-live-viewers__content">
    <strong class="product-live-viewers__count" data-viewer-count>3</strong>
    <span
      class="product-live-viewers__label"
      data-viewer-label
      data-label-singular="{% if is_ar %}شخص يشاهد هذا الآن{% else %}person is viewing this now{% endif %}"
      data-label-plural="{% if is_ar %}أشخاص يشاهدون هذا الآن{% else %}people are viewing this now{% endif %}"
    >
      {%- if is_ar -%}
        أشخاص يشاهدون هذا الآن
      {%- else -%}
        people are viewing this now
      {%- endif -%}
    </span>
  </span>
</div>

<style>
  .product-live-viewers {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    margin-bottom: 6px;
    font-size: 0.9rem;
    color: var(--color-foreground, #222);
    font-weight: 500;
    width: 100%;
  }

  .product-live-viewers__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #e53e3e;
    transform-origin: center;
    animation: viewerEyePulse 1.8s infinite ease-in-out;
  }

  .product-live-viewers__icon svg {
    display: block;
  }

  .product-live-viewers__content {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .product-live-viewers__count {
    font-weight: 700;
    color: #111;
    min-width: 12px;
    display: inline-block;
    text-align: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .product-live-viewers__count.is-changing {
    transform: scale(1.3);
    opacity: 0.7;
  }

  @keyframes viewerEyePulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

<script>
  (function() {
    function updateViewerDisplay(container, count) {
      const counter = container.querySelector('[data-viewer-count]');
      const label = container.querySelector('[data-viewer-label]');
      if (!counter) return;

      counter.textContent = count;
      if (label) {
        const singular = label.dataset.labelSingular;
        const plural = label.dataset.labelPlural;
        label.textContent = count === 1 ? singular : plural;
      }
    }

    function initViewerCounters() {
      const containers = document.querySelectorAll('[data-live-viewers]');
      containers.forEach(container => {
        if (container.dataset.initialized) return;
        container.dataset.initialized = 'true';

        const counter = container.querySelector('[data-viewer-count]');
        if (!counter) return;

        let currentCount = Math.floor(Math.random() * 5) + 1;
        updateViewerDisplay(container, currentCount);

        setInterval(() => {
          let nextCount;
          do {
            nextCount = Math.floor(Math.random() * 5) + 1;
          } while (nextCount === currentCount);

          currentCount = nextCount;
          
          counter.classList.add('is-changing');
          setTimeout(() => {
            updateViewerDisplay(container, currentCount);
            counter.classList.remove('is-changing');
          }, 150);
        }, 2000);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initViewerCounters);
    } else {
      initViewerCounters();
    }
    document.addEventListener('shopify:section:load', initViewerCounters);
  })();
</script>
