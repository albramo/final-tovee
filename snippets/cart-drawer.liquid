{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <script
    type="module"
    src="{{ 'cart-complete-cart.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% comment %} Complete Your Routine (أكمل روتينك) add-to-cart handler.
    Bound globally so the routine cards inside the drawer work on every page
    (previously it lived in buy-buttons.liquid which only renders on product pages). {% endcomment %}
  <script>
    (function() {
      if (window.__routineAddHandler) return;
      window.__routineAddHandler = function(e) {
        var btn = e.target.closest('.routine-card__btn[data-add]');
        if (!btn || btn.disabled) return;
        e.preventDefault();
        var variantId = btn.dataset.variantId;
        if (!variantId) return;

        btn.disabled = true;
        btn.classList.add('is-loading');

        var formData = new FormData();
        formData.set('id', variantId);
        formData.set('quantity', '1');

        var sectionIds = ['cart-drawer-section'];
        document.querySelectorAll('cart-items-component').forEach(function(el) {
          if (el.dataset.sectionId && sectionIds.indexOf(el.dataset.sectionId) === -1) {
            sectionIds.push(el.dataset.sectionId);
          }
        });
        formData.append('sections', sectionIds.join(','));

        var deferredPromise = null;
        var createPromiseFn = window.ShopifyEvents?.CartLinesUpdateEvent?.createPromise || window.CartLinesUpdateEvent?.createPromise;
        var EventClass = window.ShopifyEvents?.CartLinesUpdateEvent || window.CartLinesUpdateEvent;

        if (createPromiseFn && EventClass) {
          deferredPromise = createPromiseFn();
          document.dispatchEvent(new EventClass({
            action: 'add',
            context: 'cart',
            lines: [{ merchandiseId: variantId, quantity: 1 }],
            promise: deferredPromise.promise
          }));
        }

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var cartUrl = window.Theme?.routes?.cart_url || '/cart';
          return fetch(cartUrl + '.json', { headers: { Accept: 'application/json' } })
            .then(function(res) { return res.json(); })
            .then(function(cartData) {
              if (deferredPromise && EventClass && typeof EventClass.createCartFromAjaxResponse === 'function') {
                deferredPromise.resolve({
                  cart: EventClass.createCartFromAjaxResponse(cartData),
                  detail: {
                    sections: data.sections || {},
                    items: cartData.items || [],
                    itemCount: cartData.item_count || 0,
                    source: 'routine-add',
                    didError: false
                  }
                });
              }

              btn.classList.remove('is-loading');
              btn.classList.add('is-added');
              var label = btn.querySelector('[data-text-label]');
              var origLabel = label ? label.textContent : '';
              if (label && btn.dataset.addedText) label.textContent = btn.dataset.addedText;

              setTimeout(function() {
                btn.classList.remove('is-added');
                if (label && origLabel) label.textContent = origLabel;
                btn.disabled = false;
              }, 1800);

              // Re-render cart-drawer-section if returned sections exist
              if (data.sections && data.sections['cart-drawer-section']) {
                var drawerSection = document.getElementById('shopify-section-cart-drawer-section');
                if (drawerSection) {
                  var newDoc = new DOMParser().parseFromString(data.sections['cart-drawer-section'], 'text/html');
                  var newContent = newDoc.getElementById('shopify-section-cart-drawer-section');
                  if (newContent) drawerSection.innerHTML = newContent.innerHTML;
                }
              }

              var drawer = document.querySelector('theme-drawer#cart-drawer');
              if (drawer && typeof drawer.open === 'function') {
                drawer.open();
              }
            });
        })
        .catch(function(err) {
          console.error('Error adding routine product to cart:', err);
          if (deferredPromise) deferredPromise.reject(err);
          btn.classList.remove('is-loading');
          btn.disabled = false;
        });
      };
      document.addEventListener('click', window.__routineAddHandler);
    })();
  </script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
    data-overlay
    {% if request.locale.iso_code contains 'ar' %}dir="rtl"{% endif %}
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                {% render 'free-shipping-bar' %}
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}

                  {% comment %} Complete Your Routine in Cart Drawer {% endcomment %}
                  {%- liquid
                    assign cart_product_ids = cart.items | map: 'product_id'
                    assign all_products = collections.all.products
                    assign routine_count = 0
                  -%}
                  {%- capture routine_products_html -%}
                    {%- for routine_prod in all_products -%}
                      {%- if routine_prod.available and routine_count < 3 -%}
                        {%- unless cart_product_ids contains routine_prod.id -%}
                          {%- assign routine_count = routine_count | plus: 1 -%}
                          {%- assign routine_variant = routine_prod.selected_or_first_available_variant -%}
                          {%- assign variant_id = routine_variant.id -%}
                          {%- assign routine_img = routine_prod.featured_media.preview_image | default: routine_prod.featured_image -%}
                          <div class="routine-card">
                            <a href="{{ routine_prod.url }}" class="routine-card__image-link">
                              {%- if routine_img -%}
                                <img
                                  src="{{ routine_img | image_url: width: 140 }}"
                                  alt="{{ routine_prod.title | escape }}"
                                  loading="lazy"
                                  width="70"
                                  height="70"
                                  class="routine-card__image"
                                >
                              {%- else -%}
                                <div class="routine-card__image-placeholder"></div>
                              {%- endif -%}
                            </a>
                            <div class="routine-card__info">
                              <a href="{{ routine_prod.url }}" class="routine-card__title">
                                {{ routine_prod.title }}
                              </a>
                              <div class="routine-card__price">
                                {%- if routine_variant.compare_at_price > routine_variant.price -%}
                                  <s class="routine-card__compare-price">{{ routine_variant.compare_at_price | money }}</s>
                                  <span class="routine-card__sale-price">{{ routine_variant.price | money }}</span>
                                {%- elsif routine_prod.compare_at_price > routine_prod.price -%}
                                  <s class="routine-card__compare-price">{{ routine_prod.compare_at_price | money }}</s>
                                  <span class="routine-card__sale-price">{{ routine_prod.price | money }}</span>
                                {%- else -%}
                                  {{ routine_variant.price | default: routine_prod.price | money }}
                                {%- endif -%}
                              </div>
                            </div>
                            <button
                              type="button"
                              class="routine-card__btn"
                              data-add
                              data-variant-id="{{ variant_id }}"
                              data-quantity="1"
                data-add-text="{{ 'products.product.add_btn' | t }}"
                data-added-text="{{ 'products.product.added_btn' | t }}"
                            >
                              <span class="routine-card__spinner" aria-hidden="true"></span>
                              <span data-text-label>{{ 'products.product.add_btn' | t }}</span>
                            </button>
                          </div>
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {%- if routine_count > 0 -%}
                    <div class="routine-section routine-section--cart">
                      <div class="routine-section__header">
                        <h3 class="routine-section__title">
                          {{ 'products.product.complete_your_routine' | t }}
                        </h3>
                      </div>
                      <div class="routine-section__products">
                        {{ routine_products_html }}
                      </div>
                    </div>
                  {%- endif -%}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}

                  <button
                    type="button"
                    class="cart-drawer__continue-shopping button-unstyled"
                    on:click="#cart-drawer/close"
                  >
                    {{- 'actions.continue_shopping' | t -}}
                  </button>
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  /* ── Cart drawer refinements ── */
  theme-drawer#cart-drawer .theme-drawer__dialog {
    --theme-drawer-width: min(28.75rem, 100vw);
  }

  theme-drawer#cart-drawer .theme-drawer__dialog[open] {
    border-start-start-radius: var(--style-border-radius-lg);
    border-end-start-radius: var(--style-border-radius-lg);
  }

  theme-drawer#cart-drawer .theme-drawer__dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  [dir="rtl"] theme-drawer#cart-drawer .theme-drawer__dialog[open] {
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    border-start-end-radius: var(--style-border-radius-lg);
    border-end-end-radius: var(--style-border-radius-lg);
  }

  theme-drawer#cart-drawer .theme-drawer__header {
    padding: var(--padding-md) var(--padding-lg);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  theme-drawer#cart-drawer .theme-drawer__title {
    font-size: var(--font-size--lg);
    letter-spacing: 0.01em;
  }

  .cart-drawer__content .theme-drawer__title {
    font-size: var(--font-size--md);
    color: rgb(var(--color-foreground-rgb) / 0.85);
    margin-block-end: var(--margin-md);
  }

  .cart-drawer__continue-shopping {
    margin-block-start: calc(var(--gap-md) * -0.5);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / 0.65);
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-foreground-rgb) / 0.25);
    text-underline-offset: 3px;
    cursor: pointer;
    padding-block: var(--padding-2xs);

    &:hover {
      color: var(--color-foreground);
      text-decoration-color: currentColor;
    }
  }

  .theme-drawer__dialog .cart__checkout-button {
    border-radius: var(--style-border-radius-buttons-primary);
    transition: transform 0.2s var(--ease-out-cubic), filter 0.2s ease;

    &:hover:not(:disabled) {
      transform: translateY(-1px);
      filter: brightness(1.04);
    }
  }

  .theme-drawer__dialog .cart-totals__total-value {
    font-size: var(--font-size--xl);
  }

  /* Item thumbnails: soft rounded corners inside the drawer */
  .theme-drawer__dialog .cart-items__media-container {
    border-radius: var(--style-border-radius-md);
    overflow: hidden;
  }

  .theme-drawer__dialog .cart-items__title {
    font-weight: 500;
  }

  .theme-drawer__dialog .cart-items__price {
    font-weight: 600;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));
    /* Let clicks pass through the faded top strip to the scrolled items
       below (e.g. the "complete your cart" add buttons). */
    pointer-events: none;

    & > * {
      pointer-events: auto;
    }

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* ── Free shipping progress bar ── */
  .free-shipping-bar {
    flex-shrink: 0;
    padding: var(--padding-sm) var(--cart-drawer-padding) var(--padding-sm);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.06);
  }

  .free-shipping-bar__text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.6rem;
    font-size: var(--font-size--sm);
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  [dir="rtl"] .free-shipping-bar__text {
    flex-direction: row;
  }

  .free-shipping-bar__icon {
    flex-shrink: 0;
    font-size: 1rem;
  }

  .free-shipping-bar__label strong {
    color: #800020;
    font-weight: 600;
  }

  .free-shipping-bar.is-complete .free-shipping-bar__text {
    color: rgb(var(--color-foreground-rgb) / 0.9);
  }

  .free-shipping-bar__track {
    height: 7px;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
    overflow: hidden;
  }

  .free-shipping-bar__fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #800020, #c22a4d);
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [dir="rtl"] .free-shipping-bar__fill {
    background: linear-gradient(270deg, #800020, #c22a4d);
  }

  .free-shipping-bar.is-complete .free-shipping-bar__fill {
    background: linear-gradient(90deg, #1a9e55, #35c97a);
  }

  /* ── Complete your cart carousel ── */
  .cart-complete-cart {
    margin-block: var(--gap-lg) var(--padding-lg);
    padding-block-start: var(--padding-lg);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .cart-complete-cart__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    margin-block-end: var(--padding-md);
  }

  .cart-complete-cart__title {
    margin: 0;
    font-size: var(--font-size--sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .cart-complete-cart__nav {
    display: flex;
    gap: var(--gap-2xs);
  }

  .cart-complete-cart__arrow {
    --arrow-size: 2rem;

    width: var(--arrow-size);
    height: var(--arrow-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;

    & svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    &:hover:not(:disabled) {
      background-color: rgb(var(--color-foreground-rgb) / 0.08);
    }

    &[disabled] {
      opacity: 0.3;
      cursor: default;
    }
  }

  .cart-complete-cart__track {
    display: flex;
    gap: var(--gap-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .cart-complete-cart__slide {
    flex: 0 0 46%;
    min-width: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    padding: var(--padding-sm);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: var(--style-border-radius-md);
    background-color: rgb(var(--color-foreground-rgb) / 0.02);
  }

  .cart-complete-cart__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--style-border-radius-sm);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .cart-complete-cart__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cart-complete-cart__product-title {
    font-size: var(--font-size--xs);
    color: var(--color-foreground);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
    line-height: 1.3;
  }

  .cart-complete-cart__add-button {
    margin-block-start: auto;
    width: 100%;
    padding-block: var(--padding-xs);
    border-radius: var(--style-border-radius-pills);
    font-size: var(--font-size--xs);
    font-weight: 600;
    cursor: pointer;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    transition: opacity 0.2s ease, transform 0.2s var(--ease-out-cubic);

    &:hover:not(:disabled) {
      opacity: 0.85;
      transform: translateY(-1px);
    }

    &[disabled] {
      opacity: 0.5;
      cursor: default;
    }

    &.is-added {
      background-color: rgb(var(--color-foreground-rgb) / 0.12);
      color: var(--color-foreground);
    }

    &.is-loading {
      opacity: 0.75;

      [data-text-label] {
        display: none;
      }
    }
  }

  .cart-complete-cart__spinner {
    display: none;
    width: 0.9em;
    height: 0.9em;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: cart-complete-cart-spin 0.7s linear infinite;

    .is-loading & {
      display: inline-block;
    }
  }

  @keyframes cart-complete-cart-spin {
    to {
      transform: rotate(360deg);
    }
  }
{% endstylesheet %}
