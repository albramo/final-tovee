{%- assign iso = request.locale.iso_code | downcase -%}
{%- if iso contains 'ar' or iso contains 'he' or iso contains 'fa' or iso contains 'ur' -%}
  rtl
{%- elsif iso == 'ae' or iso == 'arc' or iso == 'bcc' or iso == 'bqi' or iso == 'ckb' or iso == 'dv' or iso == 'glk' or iso == 'ha' or iso == 'kwh' or iso == 'ks' or iso == 'ku' or iso == 'mzn' or iso == 'nqo' or iso == 'pnb' or iso == 'ps' or iso == 'sd' or iso == 'ug' or iso == 'yi' -%}
  rtl
{%- else -%}
  ltr
{%- endif -%}