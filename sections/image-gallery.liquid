<div class="image-gallery section section--{{ section.settings.section_width }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% if section.settings.title != blank %}
    <div class="image-gallery__header">
      <h2 class="image-gallery__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="image-gallery__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="image-gallery__list">
    {% for block in section.blocks %}
      <div class="image-gallery__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <a
            href="{{ block.settings.link }}"
            class="image-gallery__media"
            {% if block.settings.link == blank %}aria-disabled="true"{% endif %}
          >
            {{
              block.settings.image
              | image_url: width: 1920
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500, 1920',
                sizes: '100vw',
                class: 'image-gallery__image'
            }}
          </a>
        {% else %}
          <div class="image-gallery__media image-gallery__media--placeholder">
            {{ 'image' | placeholder_svg_tag: 'image-gallery__placeholder' }}
          </div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h3 class="image-gallery__heading">{{ block.settings.heading }}</h3>
        {% endif %}
        {% if block.settings.text != blank %}
          <p class="image-gallery__text">{{ block.settings.text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .image-gallery__header {
    text-align: center;
    margin-block-end: 24px;
  }

  .image-gallery__title {
    margin: 0;
  }

  .image-gallery__subtitle {
    margin: 8px 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .image-gallery__list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .image-gallery__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .image-gallery__media {
    display: block;
    overflow: hidden;
    border-radius: 8px;
  }

  .image-gallery__image,
  .image-gallery__placeholder {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .image-gallery__media:hover .image-gallery__image {
    transform: scale(1.02);
  }

  .image-gallery__media--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .image-gallery__heading {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .image-gallery__text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (max-width: 749px) {
    .image-gallery__list {
      gap: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Image Gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "blocks": [
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}