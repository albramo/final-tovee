{%- comment -%}
  Section: 404 Error Page
  Custom elegant 404 with bilingual (EN/AR) content and RTL support.
  Typography follows the theme variables, so Arabic uses Noto Kufi Arabic automatically.
{%- endcomment -%}

{%- liquid
  assign is_arabic = true
  if request.locale.iso_code contains 'en' or request.path contains '/en/'
    assign is_arabic = false
  endif
-%}

{%- if is_arabic -%}
  {%- assign heading_text = section.settings.heading_ar | default: 'عذراً، الصفحة غير موجودة' -%}
  {%- assign subheading_text = section.settings.subheading_ar | default: 'يبدو أن الصفحة التي تبحث عنها غير متوفرة أو تم نقلها. لا تقلق — يمكنك العودة للمتجر ومتابعة التسوق.' -%}
  {%- assign shop_label = section.settings.shop_label_ar | default: 'تسوق جميع المنتجات' -%}
  {%- assign badge_text = 'خطأ 404' -%}
{%- else -%}
  {%- assign heading_text = section.settings.heading | default: 'Oops! Page not found' -%}
  {%- assign subheading_text = section.settings.subheading | default: 'The page you are looking for does not exist or has been moved. No worries — head back to the store and keep shopping.' -%}
  {%- assign shop_label = section.settings.shop_label | default: 'Shop All Products' -%}
  {%- assign badge_text = 'Error 404' -%}
{%- endif -%}

{%- assign accent_color = section.settings.accent_color | default: '#ECE2CF' -%}
{%- assign ink_color = section.settings.text_color | default: '#111111' -%}
{%- assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url -%}

{% style %}
  .error-404 {
    --error-accent: {{ accent_color }};
    --error-ink: {{ ink_color }};

    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100svh - var(--header-group-height, 0px));
    padding: clamp(48px, 8vw, 96px) 20px;
    background: var(--color-background, #ffffff);
    text-align: center;
  }

  .error-404__orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .error-404__orb--a {
    width: clamp(300px, 46vw, 580px);
    height: clamp(300px, 46vw, 580px);
    top: -12%;
    left: -10%;
    background: radial-gradient(circle at 30% 30%, var(--error-accent), transparent 72%);
    opacity: 0.55;
  }

  .error-404__orb--b {
    width: clamp(240px, 38vw, 460px);
    height: clamp(240px, 38vw, 460px);
    bottom: -14%;
    right: -8%;
    background: radial-gradient(circle at 60% 60%, var(--error-accent), transparent 70%);
    opacity: 0.4;
  }

  .error-404__inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    animation: error-404-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .error-404__code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2px, 1.5vw, 14px);
    font-family: var(--font-heading--family);
    line-height: 1;
    color: var(--error-ink);
  }

  .error-404__digit {
    font-size: clamp(7.5rem, 22vw, 15rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .error-404__digit--zero {
    position: relative;
  }

  .error-404__ring {
    position: absolute;
    inset: -0.05em;
    border: 4px dashed var(--error-accent);
    border-radius: 50%;
    animation: error-404-spin 24s linear infinite;
  }

  .error-404__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: clamp(20px, 4vw, 40px);
    padding: 8px 18px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 999px;
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground, #000000);
    background: transparent;
  }

  .error-404__heading {
    margin: clamp(16px, 3vw, 28px) auto 0;
    max-width: 32ch;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-foreground, #111111);
  }

  .error-404__text {
    margin: 14px auto 0;
    max-width: 40ch;
    font-family: var(--font-body--family);
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 400;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .error-404__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: clamp(28px, 5vw, 44px);
  }

  .error-404__shop-btn {
    background-color: #800020 !important;
    color: #ffffff !important;
    border-color: #800020 !important;
  }

  .error-404__shop-btn:hover {
    background-color: #600018 !important;
  }

  @keyframes error-404-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes error-404-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-404__ring,
    .error-404__inner {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .error-404__actions {
      flex-direction: column;
      align-items: center;
    }

    .error-404__actions .button,
    .error-404__actions .button-secondary {
      width: 100%;
      max-width: 300px;
    }
  }
{% endstyle %}

<section
  class="error-404"
  data-section-id="{{ section.id }}"
  {% if is_arabic %}dir="rtl"{% endif %}
>
  <div class="error-404__orb error-404__orb--a" aria-hidden="true"></div>
  <div class="error-404__orb error-404__orb--b" aria-hidden="true"></div>

  <div class="error-404__inner">
    <div class="error-404__code" aria-hidden="true">
      <span class="error-404__digit">4</span>
      <span class="error-404__digit error-404__digit--zero">
        <span class="error-404__ring"></span>
        <span class="error-404__zero-char">0</span>
      </span>
      <span class="error-404__digit">4</span>
    </div>

    <span class="error-404__badge">{{ badge_text }}</span>

    <h1 class="error-404__heading">{{ heading_text }}</h1>
    <p class="error-404__text">{{ subheading_text }}</p>

    <div class="error-404__actions">
      <a href="{{ shop_url }}" class="button error-404__shop-btn">{{ shop_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.404",
  "tag": "section",
  "class": "section-error-404",
  "settings": [
    {
      "type": "header",
      "content": "English"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oops! Page not found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The page you are looking for does not exist or has been moved. No worries — head back to the store and keep shopping."
    },
    {
      "type": "header",
      "content": "العربية"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "العنوان",
      "default": "عذراً، الصفحة غير موجودة"
    },
    {
      "type": "textarea",
      "id": "subheading_ar",
      "label": "الوصف",
      "default": "يبدو أن الصفحة التي تبحث عنها غير متوفرة أو تم نقلها. لا تقلق — يمكنك العودة للمتجر ومتابعة التسوق."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Shop All Products"
    },
    {
      "type": "text",
      "id": "shop_label_ar",
      "label": "زر المتجر",
      "default": "تسوق جميع المنتجات"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ECE2CF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#111111"
    }
  ]
}
{% endschema %}