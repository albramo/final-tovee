{% liquid
  assign section_id = section.id
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
%}

<wall-of-love
  id="WallOfLove-{{ section_id }}"
  class="wall-of-love section section--{{ section.settings.section_width }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};"
  data-autoplay="{{ autoplay }}"
  data-autoplay-speed="{{ autoplay_speed }}"
>
  {% if section.settings.title != blank %}
    <div class="wall-of-love__header">
      <h2 class="wall-of-love__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="wall-of-love__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="wall-of-love__viewport">
    <div class="wall-of-love__track">
      {% for block in section.blocks %}
        <div
          class="wall-of-love__slide"
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="wall-of-love__card">
            {% if block.settings.embed_code != blank %}
              <div class="wall-of-love__media wall-of-love__media--video">
                {{ block.settings.embed_code }}
              </div>
            {% elsif block.settings.image != blank %}
              <div class="wall-of-love__media">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 600',
                    sizes: '(min-width: 750px) 560px, 90vw',
                    class: 'wall-of-love__image'
                }}
              </div>
            {% else %}
              <div class="wall-of-love__media wall-of-love__media--placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'wall-of-love__image' }}
              </div>
            {% endif %}

            {% if block.settings.rating > 0 %}
              <div class="wall-of-love__stars" aria-label="{{ block.settings.rating }} / 5">
                {% for i in (1..5) %}
                  <svg
                    class="wall-of-love__star{% if forloop.index <= block.settings.rating %} is-filled{% endif %}"
                    width="16"
                    height="16"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M10 1.5L12.6 7.2L18.8 7.9L14.2 12.1L15.5 18.2L10 15.1L4.5 18.2L5.8 12.1L1.2 7.9L7.4 7.2L10 1.5Z" fill="currentColor"/>
                  </svg>
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.review != blank %}
              <p class="wall-of-love__review">“{{ block.settings.review }}”</p>
            {% endif %}

            <div class="wall-of-love__meta">
              {% if block.settings.name != blank %}
                <span class="wall-of-love__name">{{ block.settings.name }}</span>
              {% endif %}
              {% if block.settings.platform != 'none' %}
                <span class="wall-of-love__platform">{{ block.settings.platform }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 3 %}
      <button
        type="button"
        class="wall-of-love__arrow wall-of-love__arrow--prev"
        data-prev
        aria-label="Previous"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="wall-of-love__arrow wall-of-love__arrow--next"
        data-next
        aria-label="Next"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="wall-of-love__dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="wall-of-love__dot{% if forloop.first %} is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</wall-of-love>

<script src="{{ 'wall-of-love.js' | asset_url }}" type="module" fetchpriority="low"></script>

<style>
  .wall-of-love__header {
    text-align: center;
    margin-block-end: 28px;
  }

  .wall-of-love__title {
    margin: 0;
  }

  .wall-of-love__subtitle {
    margin: 8px 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .wall-of-love__viewport {
    position: relative;
    overflow: hidden;
    max-width: 960px;
    margin-inline: auto;
  }

  .wall-of-love__track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wall-of-love__slide {
    flex: 0 0 100%;
    min-width: 0;
    padding-inline: 8px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .wall-of-love__slide {
      flex-basis: 33.333%;
    }
  }

  .wall-of-love__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    height: 100%;
    padding: 20px;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 12px;
    box-sizing: border-box;
  }

  .wall-of-love__media {
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .wall-of-love__media--video {
    aspect-ratio: 9 / 16;
    max-width: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wall-of-love__media--video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .wall-of-love__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
  }

  .wall-of-love__stars {
    display: flex;
    gap: 2px;
    color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .wall-of-love__star.is-filled {
    color: #f5a623;
  }

  .wall-of-love__review {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.85);
    max-width: 420px;
  }

  .wall-of-love__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-block-start: auto;
  }

  .wall-of-love__name {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .wall-of-love__platform {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 20px;
    padding: 2px 10px;
  }

  .wall-of-love__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 36px;
    height: 36px;
    padding: 0;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 50%;
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .wall-of-love__arrow:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
    border-color: rgb(var(--color-foreground-rgb));
  }

  .wall-of-love__arrow--prev {
    left: 0;
  }

  .wall-of-love__arrow--next {
    right: 0;
  }

  .wall-of-love__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-block-start: 18px;
  }

  .wall-of-love__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    background: rgb(var(--color-foreground-rgb) / 0.2);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .wall-of-love__dot:hover {
    background: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .wall-of-love__dot.is-active {
    background: var(--color-foreground);
    transform: scale(1.25);
  }

  @media screen and (max-width: 749px) {
    .wall-of-love__card {
      padding: 16px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Wall of Love",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "العنوان (Title)",
      "default": "آراء عملائنا"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "العنوان الفرعي (Subtitle)"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "عرض القسم (Section width)",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "لون الخلفية (Background color)",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "تقييم (Review)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "صورة التقييم (Image)"
        },
        {
          "type": "textarea",
          "id": "embed_code",
          "label": "كود تضمين فيديو (Instagram / TikTok)",
          "info": "انسخ كود التضمين (Embed) من منشور انستجرام أو تيك توك والصقه هنا. اتركه فارغاً لاستخدام الصورة."
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "نص التقييم (Review)",
          "default": "منتج رائع والجودة ممتازة، أنصح به بشدة!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "اسم العميل (Customer name)",
          "default": "عميل سعيد"
        },
        {
          "type": "select",
          "id": "platform",
          "label": "المصدر (Platform)",
          "options": [
            {
              "value": "none",
              "label": "بدون"
            },
            {
              "value": "Instagram",
              "label": "Instagram"
            },
            {
              "value": "TikTok",
              "label": "TikTok"
            },
            {
              "value": "YouTube",
              "label": "YouTube"
            },
            {
              "value": "Facebook",
              "label": "Facebook"
            }
          ],
          "default": "Instagram"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "التقييم بالنجوم (Rating)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wall of Love",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review",
          "settings": {
            "review": "التوصيل كان سريع والتغليف احترافي، شكراً لكم!",
            "name": "سارة"
          }
        },
        {
          "type": "review",
          "settings": {
            "review": "جودة المنتج فاقت توقعاتي، هطلب تاني بالتأكيد.",
            "name": "محمد"
          }
        }
      ]
    }
  ]
}
{% endschema %}