<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' or request.locale.iso_code == 'fa' or request.locale.iso_code == 'ur' %}rtl{% else %}ltr{% endif %}"
>
  <head>
    <script>
      // VibeWeb branding — the only console output on this site.
      // Prints the branding message first, then silences everything else.
      (function () {
        var styles =
          'background:#111;color:#ECE2CF;padding:6px 12px;border-radius:4px;font-weight:700;font-size:13px;font-family:system-ui,sans-serif;';
        var facebookUrl = 'https://www.facebook.com/profile.php?id=61593002010778';
        var brandedLog = function () {
          console.log('%cDesigned & developed by VibeWeb', styles);
          console.log('Facebook: ' + facebookUrl);
        };

        brandedLog();

        var originalClear = console.clear.bind(console);
        var noop = function () {};
        ['log', 'info', 'warn', 'error', 'debug', 'trace', 'table', 'dir', 'dirxml', 'group', 'groupCollapsed', 'groupEnd', 'assert', 'count', 'countReset', 'time', 'timeEnd', 'timeLog', 'profile', 'profileEnd'].forEach(function (key) {
          try { console[key] = noop; } catch (e) {}
        });

        // Keep the branding visible even if the console is cleared.
        try {
          console.clear = function () {
            originalClear();
            brandedLog();
          };
        } catch (e) {}
      })();
    </script>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% comment %}
      Critical mobile-bottom-nav styles inlined in head so the fixed bar and
      body bottom padding apply at first paint (prevents the late-appearance
      layout shift). Keep in sync with the @media rules in
      snippets/mobile-bottom-nav.liquid.
    {% endcomment %}
    {% style %}
      @media screen and (max-width: 749px) {
        body:has(mobile-bottom-nav) {
          padding-block-end: calc(56px + env(safe-area-inset-bottom));
        }
      }
    {% endstyle %}

    {% comment %}
      Brand override: keeps the primary/secondary button hover at the brand's
      milky beige (لبني) instead of the auto-computed shift from theme settings.
      Rendered after color-palette so it wins the cascade.
    {% endcomment %}
    {% style %}
      :root {
        --color-primary-button-hover-background: #ECE2CF;
        --color-primary-button-hover-text: #000000;
        --color-primary-button-hover-border: #ECE2CF;
        --color-secondary-button-hover-background: #ECE2CF;
        --color-secondary-button-hover-text: #000000;
        --color-secondary-button-hover-border: #ECE2CF;
      }
    {% endstyle %}

    {% comment %} RTL / Arabic support - logical properties & font tweaks {% endcomment %}
    {% style %}
      /* === RTL overflow guard: تمنع المساحة البيضاء والموقع اللي يجي على جنب في الموبايل === */
      html[dir='rtl'] {
        text-align: start;
        overflow-x: clip;
        max-width: 100%;
      }
      html[dir='rtl'] body {
        direction: rtl;
        font-feature-settings: 'liga' 1, 'calt' 1;
        letter-spacing: normal;
        overflow-x: clip;
        max-width: 100%;
        /* مهم للموبايل: يمنع سحب الصفحة أفقياً */
        overscroll-behavior-x: none;
      }
      html[dir='rtl'] .page-wrapper {
        overflow-x: clip;
        max-width: 100%;
        width: 100%;
      }
      html[dir='rtl'] .section,
      html[dir='rtl'] .shopify-section {
        max-width: 100%;
        overflow-x: clip;
      }
      /* أي عنصر كان 100vw يسبب overflow في RTL — نحوله 100% */
      html[dir='rtl'] .menu-drawer__backdrop {
        width: 100% !important;
        max-width: 100% !important;
      }
      html[dir='rtl'] zoom-dialog dialog {
        width: 100% !important;
        max-width: 100% !important;
      }
      /* إصلاح منطقي للـ grid المركزي: في RTL كان --full-page-margin-inline-offset يسبب انحراف */
      html[dir='rtl'] .section {
        /* يضمن عدم خروج الشبكة عن الشاشة */
        overflow: clip;
      }
      /* === إصلاح الكاروسيل/السلايدر في RTL: القفل على LTR للـ scroller يمنع تعطل الـ JS === */
      html[dir='rtl'] slideshow-slides,
      html[dir='rtl'] .slideshow-slides,
      html[dir='rtl'] scroll-hint,
      html[dir='rtl'] [part='list'] {
        direction: ltr;
      }
      html[dir='rtl'] slideshow-slide,
      html[dir='rtl'] .slideshow-slide,
      html[dir='rtl'] scroll-hint > *,
      html[dir='rtl'] [part='list'] > * {
        direction: rtl;
      }
      /* يضمن أن حسابات scrollIntoView و Scroller لا تنكسر بسبب scrollLeft السالب في RTL */
      html[dir='rtl'] slideshow-component {
        direction: ltr;
      }
      html[dir='rtl'] slideshow-component slideshow-slide {
        direction: rtl;
      }
      /* Footer RTL: padding flips automatically via padding-inline-start, brand inset flips too - no extra needed */
      html[dir='rtl'] .footer-brand-column {
        text-align: start;
      }
      html[dir='rtl'] .footer-content .menu__item a,
      html[dir='rtl'] .footer-content .footer-policy-column__link {
        text-align: start;
      }
      /* Localization dropdown mirrors correctly in RTL */
      html[dir='rtl'] dropdown-localization-component .localization-wrapper.right-bound {
        right: unset;
        inset-inline-end: 0;
        inset-inline-start: unset;
      }
      html[dir='rtl'] dropdown-localization-component .localization-wrapper.left-bound {
        left: unset;
        inset-inline-start: -8px;
        inset-inline-end: unset;
      }
      html[dir='rtl'] .country-filter__input {
        padding-inline-start: calc(var(--margin-md) + var(--padding-xl));
        padding-inline-end: var(--padding-lg);
      }
      /* Policy & Page content RTL - ensure correct reading direction */
      html[dir='rtl'] .page-content,
      html[dir='rtl'] .page-content .rte,
      html[dir='rtl'] rte-formatter,
      html[dir='rtl'] .shopify-policy__body,
      html[dir='rtl'] .shopify-policy__title,
      html[dir='rtl'] .rte,
      html[dir='rtl'] .text-block {
        direction: rtl;
        text-align: start;
      }
      html[dir='rtl'] .page-content h1,
      html[dir='rtl'] .page-content h2,
      html[dir='rtl'] .page-content h3,
      html[dir='rtl'] .shopify-policy__title {
        text-align: start;
      }
      /* Contact form and generic pages flip labels */
      html[dir='rtl'] .field__label,
      html[dir='rtl'] label {
        text-align: start;
      }
      /* Header logo: استخدم logical properties بدل left الفيزيائي */
      html[dir='rtl'] .header__columns .header-logo,
      html[dir='rtl'] #header-component[data-menu-style='drawer'] .header__columns .header-logo {
        left: auto !important;
        inset-inline-start: 50% !important;
        transform: translate(-50%, -50%) !important;
      }
      /* منع أي عنصر يهرب خارج الشاشة في RTL موبايل */
      @media screen and (max-width: 749px) {
        html[dir='rtl'] {
          scrollbar-gutter: auto !important;
        }
        html[dir='rtl'] body,
        html[dir='rtl'] .page-wrapper {
          overflow-x: clip !important;
        }
        html[dir='rtl'] img,
        html[dir='rtl'] picture,
        html[dir='rtl'] video {
          max-width: 100% !important;
        }
      }
    {% endstyle %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'wishlist-drawer' %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'mobile-bottom-nav' %}
  </body>
</html>
